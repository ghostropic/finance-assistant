{
  "name": "finance-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint src tests scripts eslint.config.mjs next.config.ts postcss.config.mjs prisma.config.ts vitest.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:generate": "prisma generate",
    "plaid:sandbox": "tsx scripts/sandbox-setup.ts",
    "sync": "tsx scripts/sync.ts",
    "chat": "tsx scripts/chat.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "format": "prettier --write . --ignore-path .prettierignore --ignore-path .gitignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .prettierignore --ignore-path .gitignore --ignore-path .git/info/exclude"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "dotenv": "18.0.5",
    "next": "16.4.5",
    "pg": "8.23.1",
    "plaid": "47.0.0",
    "react": "19.2.8",
    "react-aria": "3.53.0",
    "react-aria-components": "1.22.0",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-plaid-link": "5.0.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
