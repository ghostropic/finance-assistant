# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Plaid (Sandbox keys while developing)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Postgres (matches docker-compose.yml). Tests don't use this; they run on an in-memory Postgres.
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_assistant

# 32-byte key for encrypting Plaid access tokens. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
